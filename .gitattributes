# Fora do pacote do Composer (o zip do Packagist): só o que o fórum usa.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.editorconfig export-ignore
/tests export-ignore
/phpstan.neon export-ignore
/js/src export-ignore
/js/*.json export-ignore
/js/*.js export-ignore
/js/*.ts export-ignore

# O JavaScript compilado não entra nos diffs nem nas estatísticas de linguagem.
js/dist/** -diff linguist-generated
